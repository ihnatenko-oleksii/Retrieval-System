# Validated retrieval configuration
# Retrieval requires the Hugging Face embedding model below. After changing
# EMBEDDING_MODEL, CHUNK_SIZE, or CHUNK_OVERLAP, re-ingest the corpus so stored
# vectors and chunks match the configuration. The query-only instruction does
# not change stored document vectors.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# To keep using an existing E5 index, set EMBEDDING_MODEL to the original model
# instead; do not query an E5 index with the Qwen3 default.
# EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_QUERY_INSTRUCTION=Given a technical support or engineering question, retrieve passages that directly answer the question or contain the necessary implementation details.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
HYBRID_SEARCH_WEIGHTS_DENSE=0.7
HYBRID_SEARCH_WEIGHTS_SPARSE=0.3
FUSION_STRATEGY=weighted_linear
ADAPTIVE_ROUTING=false

# Retrieval returns three context chunks by default for the interactive UX.
# The validated benchmark reports metrics at top_k=5; this is a measurement
# convention, not a requirement that the application return five chunks.
RETRIEVAL_TOP_K=3
RETRIEVAL_CANDIDATE_DEPTH=20

# Optional local generation. Retrieval itself does not require Ollama.
LLM_MODEL=qwen3.5:4b-mlx

# Optional experimental features: keep disabled for the validated path.
RERANKER_ON=false
QUERY_REWRITING_ON=false
QUERY_EXPANSION_ON=false
PRF_ON=false
NATIVE_BGE_ON=false
LTR_ON=false
